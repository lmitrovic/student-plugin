<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.lmitrovic.studenttestingintellijplugin</id>
    <name>Studentski Panel</name>
    <vendor url="https://github.com/RAFSoftLab">RAFSoftLab</vendor>

    <!-- since-build / until-build se postavljaju iz gradle.properties preko patchPluginXml -->

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.lmitrovic.studenttestingintellijplugin.toolWindow.MyToolWindowFactory"
                    id="Studentski plugin"
                    icon="/icons/pluginIcon.svg"/>

        <notificationGroup id="RAF LMS Updates"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <postStartupActivity implementation="com.github.lmitrovic.studenttestingintellijplugin.startup.PluginStartupActivity"/>
    </extensions>
</idea-plugin>
